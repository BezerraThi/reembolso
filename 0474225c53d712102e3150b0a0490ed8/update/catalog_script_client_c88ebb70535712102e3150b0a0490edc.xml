        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var today = new Date();
   
   var selectedDate = new Date(newValue + "T00:00:00Z"); 

   if (selectedDate > today) {
      g_form.addErrorMessage("Vish!! It looks like you selected a date in the future, choose dates only in the past");
      g_form.setValue("expense_date", "");
   } else {
      g_form.clearMessages();
   }
}
]]></script>
